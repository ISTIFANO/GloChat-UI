# Copy to .env (git-ignored) or set these in the build/deploy environment.
# They become public/config.json, read by the browser: PUBLIC values only, never a secret.
# Values below are for local development.

# api-gateway origin; leave empty when the gateway is served on the same origin as the web app
API_BASE_URL=http://localhost:8080
KEYCLOAK_ISSUER=http://localhost:8180/realms/marketchat
KEYCLOAK_CLIENT_ID=marketchat-app

# Where the catalog is browsed until the customer picks an address
DEFAULT_LOCATION_LABEL=Agdal, Rabat
DEFAULT_LOCATION_LAT=33.9981
DEFAULT_LOCATION_LNG=-6.8497

# e2e tests (python e2e/*.e2e.py): where the web app runs
WEB_BASE_URL=http://localhost:4200
